@inherits LayoutComponentBase

<MudThemeProvider Theme="AppTheme.Mud" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudDrawer Open="true" Variant="DrawerVariant.Persistent" Elevation="1" Width="220px" ClipMode="DrawerClipMode.Never">
        <MudText Typo="Typo.h6" Class="pa-4 brand text-no-wrap"><span class="brand-n">N</span> Netflix Analytics</MudText>
        <MudNavMenu Color="Color.Primary">
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Resumen</MudNavLink>
            <MudNavLink Href="/catalogo" Icon="@Icons.Material.Filled.Movie">Catálogo</MudNavLink>
            <MudNavLink Href="/ranking" Icon="@Icons.Material.Filled.Star">Ranking</MudNavLink>
            <MudNavLink Href="/personas" Icon="@Icons.Material.Filled.People">Personas</MudNavLink>
            <MudNavLink Href="/mensajeria" Icon="@Icons.Material.Filled.SwapHoriz">Mensajería</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>
